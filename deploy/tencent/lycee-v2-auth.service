[Unit]
Description=Lycee V2 local PostgreSQL email account service
After=network-online.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=lycee-v2-auth
Group=lycee-v2-auth
WorkingDirectory=/opt/lycee-v2/current/services/auth
EnvironmentFile=/etc/lycee-v2/auth.env
ExecStart=/usr/local/bin/node server.mjs
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0077
MemoryMax=256M

[Install]
WantedBy=multi-user.target
